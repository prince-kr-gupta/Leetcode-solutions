class Solution {
public:
    string reverseParentheses(string s) {
        string ans = "";
        for(int i = 0;i<s.length();i++){
            if(s[i] == ')'){
                string temp ="";
                while(ans.back() != '('){
                    temp += ans.back();
                    ans.pop_back();
                }
                ans.pop_back();
                ans += temp;
            }
            else{
                ans += s[i];
            }
        }
            return ans;
    }
};
