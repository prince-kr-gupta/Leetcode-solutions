class Solution {
public:
 using ll = long long;
    const ll MOD = 1e9 + 7;

    struct Node {
        ll sum = 0;   // sum of distinct counts
        ll sq = 0;    // sum of squares
        ll lazy = 0;
    };

    vector<Node> tree;

    void push(int node, int l, int r, ll add) {
        ll len = r - l + 1;

        tree[node].sq = (tree[node].sq
                        + 2 * add % MOD * tree[node].sum % MOD
                        + add * add % MOD * len) % MOD;

        tree[node].sum = (tree[node].sum + add * len) % MOD;
        tree[node].lazy += add;
    }
    void propagate(int node, int l, int r) {
    if(tree[node].lazy == 0 || l == r)
        return;

    int mid = (l + r) / 2;

    push(node * 2, l, mid, tree[node].lazy);
    push(node * 2 + 1, mid + 1, r, tree[node].lazy);

    tree[node].lazy = 0;
}

    void update(int node, int l, int r, int ql, int qr) {
        if(ql > r || qr < l) return;

        if(ql <= l && r <= qr) {
            push(node, l, r, 1);
            return;
        }
          propagate(node, l, r); 
        int mid = (l + r) / 2;

        update(node * 2, l, mid, ql, qr);
        update(node * 2 + 1, mid + 1, r, ql, qr);

        tree[node].sum =
            (tree[node * 2].sum + tree[node * 2 + 1].sum) % MOD;

        tree[node].sq =
            (tree[node * 2].sq + tree[node * 2 + 1].sq) % MOD;
    }
    int sumCounts(vector<int>& nums) {
         int n = nums.size();

        tree.resize(4 * n);
        vector<int> last(100001, -1);

        ll ans = 0;

        for(int i = 0; i < n; i++) {
            int prev = last[nums[i]];

            update(1, 0, n - 1, prev + 1, i);

            last[nums[i]] = i;

            ans = (ans + tree[1].sq) % MOD;
        }
        return ans;
    }
};
